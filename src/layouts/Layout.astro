---
import "../assets/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const { 
  title = "Real QR Code Generator - Free Custom Static & Dynamic QR Codes", 
  description = "Create, track, and customize premium vector QR codes with logo uploads. Fully optimized for mobile and desktop scanners with edge-fast redirects.",
  className = ""
} = Astro.props;
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Real QR Code Generator" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Google Fonts Substitutes for Geist & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Inline script to avoid theme flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      const activeTheme = savedTheme || systemTheme;
      document.documentElement.className = activeTheme;
    </script>
  </head>
  <body class="mesh-gradient-bg min-h-screen flex flex-col selection:bg-primary selection:text-on-primary">
    <!-- Header -->
    <header class="sticky top-0 z-50 w-full border-b border-hairline bg-canvas/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
          <svg class="h-6 w-6 text-ink transition-transform duration-300 group-hover:rotate-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
            <path d="M14 14h2v2h-2z"></path>
            <path d="M20 20h2v2h-2z"></path>
            <path d="M18 18h2v2h-2z"></path>
            <path d="M14 20h2v2h-2z"></path>
            <path d="M20 14h2v2h-2z"></path>
          </svg>
          <span class="font-sans text-lg font-semibold tracking-tight text-ink">
            Real<span class="font-mono font-medium text-mute">QR</span>
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-6">
          <a href="/features" class="text-sm font-medium text-body hover:text-ink transition-colors">Features</a>
          <a href="/pricing" class="text-sm font-medium text-body hover:text-ink transition-colors">Pricing</a>
          <a href="/generator" class="text-sm font-medium text-body hover:text-ink transition-colors">Generators</a>
          <a href="/dashboard" class="text-sm font-medium text-body hover:text-ink transition-colors">Dashboard</a>
        </nav>

        <!-- Right Side Controls -->
        <div class="hidden md:flex items-center gap-4">
          <!-- Theme Toggle -->
          <button id="theme-toggle-btn" class="p-2 text-body hover:text-ink cursor-pointer transition-colors" aria-label="Toggle dark mode">
            <!-- Sun Icon (shows in Dark) -->
            <svg id="sun-icon" class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="M4.93 4.93l1.41 1.41"></path><path d="M17.66 17.66l1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="M6.34 17.66l-1.41 1.41"></path><path d="M19.07 4.93l-1.41 1.41"></path></svg>
            <!-- Moon Icon (shows in Light) -->
            <svg id="moon-icon" class="h-4 w-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
          </button>

          <a href="/login" class="text-sm font-medium text-body hover:text-ink transition-colors px-3 py-1.5 rounded-sm hover:bg-canvas-soft-2">Log In</a>
          <a href="/register" class="bg-primary text-on-primary hover:bg-neutral-800 dark:hover:bg-neutral-200 text-xs font-semibold rounded-sm h-[28px] px-3 inline-flex items-center active:scale-95 transition-all">Sign Up</a>
        </div>

        <!-- Mobile Nav Hamburger Button -->
        <div class="flex md:hidden items-center gap-2">
          <!-- Mobile Theme Toggle -->
          <button id="theme-toggle-btn-mobile" class="p-2 text-body hover:text-ink cursor-pointer" aria-label="Toggle dark mode">
            <svg class="h-4 w-4 block dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
            <svg class="h-4 w-4 hidden dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="M4.93 4.93l1.41 1.41"></path><path d="M17.66 17.66l1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="M6.34 17.66l-1.41 1.41"></path><path d="M19.07 4.93l-1.41 1.41"></path></svg>
          </button>
          
          <button id="mobile-menu-btn" class="p-2 text-ink hover:text-body cursor-pointer" aria-label="Toggle Menu">
            <svg id="hamburger-icon" class="h-5 w-5 block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
            <svg id="close-icon" class="h-5 w-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"></line><line x1="6" x2="18" y1="6" y2="18"></line></svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden border-b border-hairline bg-canvas px-4 py-4 space-y-3 md:hidden">
        <a href="/features" class="block text-sm font-medium text-body hover:text-ink">Features</a>
        <a href="/pricing" class="block text-sm font-medium text-body hover:text-ink">Pricing</a>
        <a href="/generator" class="block text-sm font-medium text-body hover:text-ink">Generators</a>
        <a href="/dashboard" class="block text-sm font-medium text-body hover:text-ink">Dashboard</a>
        <div class="h-px bg-hairline my-2"></div>
        <div class="flex items-center gap-3">
          <a href="/login" class="flex-1 text-center text-sm font-medium text-body hover:text-ink py-2 rounded-sm bg-canvas-soft-2">Log In</a>
          <a href="/register" class="flex-1 text-center text-sm font-medium bg-primary text-on-primary py-2 rounded-sm hover:bg-neutral-800 dark:hover:bg-neutral-200">Sign Up</a>
        </div>
      </div>
    </header>

    <!-- Page Content Container -->
    <main class={`flex-grow mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 py-10 ${className}`}>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="w-full border-t border-hairline bg-canvas">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
        <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
          <!-- Col 1: Product -->
          <div>
            <h3 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Product</h3>
            <ul class="space-y-3">
              <li><a href="/features" class="text-sm text-body hover:text-ink transition-colors">Features</a></li>
              <li><a href="/pricing" class="text-sm text-body hover:text-ink transition-colors">Pricing</a></li>
              <li><a href="/generator" class="text-sm text-body hover:text-ink transition-colors">All Generators</a></li>
            </ul>
          </div>

          <!-- Col 2: SEO Generators -->
          <div>
            <h3 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Solutions</h3>
            <ul class="space-y-3">
              <li><a href="/generator/wifi" class="text-sm text-body hover:text-ink transition-colors">WiFi QR Codes</a></li>
              <li><a href="/generator/vcard" class="text-sm text-body hover:text-ink transition-colors">vCard Business QRs</a></li>
              <li><a href="/generator/whatsapp" class="text-sm text-body hover:text-ink transition-colors">WhatsApp QRs</a></li>
              <li><a href="/generator/url" class="text-sm text-body hover:text-ink transition-colors">URL QRs</a></li>
            </ul>
          </div>

          <!-- Col 3: Developers -->
          <div>
            <h3 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Developers</h3>
            <ul class="space-y-3">
              <li><span class="text-sm text-mute font-mono">API Reference (Phase 2)</span></li>
              <li><span class="text-sm text-mute font-mono">Webhooks (Phase 2)</span></li>
            </ul>
          </div>

          <!-- Col 4: Platform -->
          <div>
            <h3 class="text-xs font-mono uppercase tracking-widest text-mute mb-4">Resources</h3>
            <ul class="space-y-3">
              <li><span class="text-sm text-mute">Help Center (Phase 2)</span></li>
              <li><span class="text-sm text-mute">Blog (Phase 2)</span></li>
              <li><a href="/contact" class="text-sm text-body hover:text-ink transition-colors">Contact Support</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-12 border-t border-hairline pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <!-- Bottom Brand Info -->
          <div class="flex items-center gap-2">
            <svg class="h-5 w-5 text-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
              <path d="M14 14h2v2h-2z"></path>
              <path d="M20 20h2v2h-2z"></path>
              <path d="M18 18h2v2h-2z"></path>
              <path d="M14 20h2v2h-2z"></path>
              <path d="M20 14h2v2h-2z"></path>
            </svg>
            <span class="text-sm text-mute">
              © 2026 Real QR Code Generator. Built for the modern web.
            </span>
          </div>
          
          <div class="text-xs text-mute flex gap-4">
            <span class="hover:text-ink cursor-pointer">Privacy Policy</span>
            <span class="hover:text-ink cursor-pointer">Terms of Service</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Script for mobile menu and dark mode toggles -->
    <script>
      // Theme toggling logic
      function toggleTheme() {
        const doc = document.documentElement;
        if (doc.classList.contains("dark")) {
          doc.classList.remove("dark");
          doc.classList.add("light");
          localStorage.setItem("theme", "light");
        } else {
          doc.classList.remove("light");
          doc.classList.add("dark");
          localStorage.setItem("theme", "dark");
        }
      }

      document.getElementById("theme-toggle-btn")?.addEventListener("click", toggleTheme);
      document.getElementById("theme-toggle-btn-mobile")?.addEventListener("click", toggleTheme);

      // Mobile Hamburger menu toggler
      const menuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const burgerIcon = document.getElementById("hamburger-icon");
      const closeIcon = document.getElementById("close-icon");

      menuBtn?.addEventListener("click", () => {
        const isHidden = mobileMenu?.classList.contains("hidden");
        if (isHidden) {
          mobileMenu?.classList.remove("hidden");
          burgerIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
        } else {
          mobileMenu?.classList.add("hidden");
          burgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
        }
      });
    </script>
  </body>
</html>
