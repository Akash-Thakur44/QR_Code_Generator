---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import Card from "../../components/ui/Card";
import Button from "../../components/ui/Button";
import { getDB } from "../../lib/db";
import { getSessionUser } from "../../lib/auth";

const baseOrigin = import.meta.env.PUBLIC_QR_BASE_URL || Astro.url.origin;

const user = await getSessionUser(Astro);
if (!user) {
  return Astro.redirect("/login");
}

const qrId = Astro.url.searchParams.get("qrId");
if (!qrId) {
  return Astro.redirect("/dashboard");
}

let qrDetails: any = null;
let summary = { totalScans: 0, uniqueScans: 0 };
let daily: any[] = [];
let devices: any[] = [];
let countries: any[] = [];
let browsers: any[] = [];

try {
  const db = getDB(Astro);

  // 1. Verify ownership
  qrDetails = await db
    .prepare("SELECT * FROM qr_codes WHERE id = ? AND user_id = ?")
    .bind(qrId, user.id)
    .first();

  if (!qrDetails) {
    return Astro.redirect("/dashboard");
  }

  // 2. Fetch metrics
  const totalResult = await db
    .prepare("SELECT COUNT(*) as count FROM scan_analytics WHERE qr_code_id = ?")
    .bind(qrId)
    .first<{ count: number }>();
  summary.totalScans = totalResult?.count || 0;

  const uniqueResult = await db
    .prepare("SELECT COUNT(DISTINCT ip_hash) as count FROM scan_analytics WHERE qr_code_id = ?")
    .bind(qrId)
    .first<{ count: number }>();
  summary.uniqueScans = uniqueResult?.count || 0;

  // Daily Scans (Last 14 days)
  const dailyResult = await db
    .prepare(
      `SELECT substr(scanned_at, 1, 10) as date, COUNT(*) as count 
       FROM scan_analytics 
       WHERE qr_code_id = ? 
       GROUP BY date 
       ORDER BY date DESC 
       LIMIT 14`
    )
    .bind(qrId)
    .all<any>();
  daily = dailyResult.results || [];

  // Device Breakdown
  const deviceResult = await db
    .prepare(
      `SELECT device, COUNT(*) as count 
       FROM scan_analytics 
       WHERE qr_code_id = ? 
       GROUP BY device 
       ORDER BY count DESC`
    )
    .bind(qrId)
    .all<any>();
  devices = deviceResult.results || [];

  // Country & City Breakdown
  const countryResult = await db
    .prepare(
      `SELECT country, city, COUNT(*) as count 
       FROM scan_analytics 
       WHERE qr_code_id = ? 
       GROUP BY country, city 
       ORDER BY count DESC 
       LIMIT 10`
    )
    .bind(qrId)
    .all<any>();
  countries = countryResult.results || [];

  // Browser Breakdown
  const browserResult = await db
    .prepare(
      `SELECT browser, COUNT(*) as count 
       FROM scan_analytics 
       WHERE qr_code_id = ? 
       GROUP BY browser 
       ORDER BY count DESC`
    )
    .bind(qrId)
    .all<any>();
  browsers = browserResult.results || [];

} catch (err) {
  console.error("Failed to load dashboard analytics:", err);
}

// Icon helper
const categoryIcons: Record<string, string> = {
  url: "🔗",
  wifi: "📶",
  vcard: "👤",
  whatsapp: "💬",
  email: "✉️",
  sms: "📱",
  phone: "📞",
  location: "📍",
  text: "📝",
};
---

<DashboardLayout title="Scan Analytics" activeTab="qr">
  <div class="flex items-center gap-2" slot="header-actions">
    <a href="/dashboard">
      <Button variant="secondary" size="sm" className="h-8 text-xs">
        Back to Dashboard
      </Button>
    </a>
  </div>

  <!-- QR info bar -->
  {qrDetails && (
    <div class="border border-hairline bg-canvas rounded-lg p-5 mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 shadow-sm">
      <div class="flex items-center gap-3">
        <span class="text-3xl select-none">{categoryIcons[qrDetails.category] || "📦"}</span>
        <div>
          <h2 class="text-sm font-semibold text-ink capitalize">{qrDetails.category} QR Campaign</h2>
          <span class="text-xs text-mute font-mono truncate max-w-xs" title={qrDetails.original_url}>{qrDetails.original_url}</span>
        </div>
      </div>
      <div class="text-xs text-body max-w-sm truncate" title={qrDetails.original_url}>
        <span class="font-mono text-mute">Direct Target:</span><br />
        <a href={qrDetails.original_url} target="_blank" class="text-link hover:underline font-medium">{qrDetails.original_url}</a>
      </div>
    </div>
  )}

  <!-- Aggregate counters -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
    <Card level={2} rounded="md" className="p-5 bg-canvas">
      <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Total Scans</span>
      <span class="text-3xl font-semibold text-ink block mt-1">{summary.totalScans}</span>
      <span class="text-[10px] text-mute block mt-2">Sum of all scan interactions</span>
    </Card>

    <Card level={2} rounded="md" className="p-5 bg-canvas">
      <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Unique Scans</span>
      <span class="text-3xl font-semibold text-ink block mt-1">{summary.uniqueScans}</span>
      <span class="text-[10px] text-mute block mt-2">Based on anonymized IP hashes</span>
    </Card>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Col: Daily scan timeline (8 cols) -->
    <div class="lg:col-span-8 space-y-6">
      <Card level={2} rounded="lg" className="p-6 bg-canvas">
        <h3 class="text-sm font-semibold text-ink mb-1">Daily Scan Distributions</h3>
        <p class="text-xs text-body mb-6">Daily breakdown of scans recorded in the last 14 days.</p>

        {daily.length === 0 ? (
          <div class="text-center py-12 text-xs text-mute font-mono">
            No scans recorded yet. Share your QR code to gather data.
          </div>
        ) : (
          <div class="space-y-4">
            <!-- Timeline bar graph mock or list representation -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="bg-canvas-soft border-b border-hairline font-mono text-[10px] text-mute uppercase tracking-widest">
                    <th class="p-3">Date</th>
                    <th class="p-3 text-right">Scans</th>
                    <th class="p-3 text-right">Share</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                  {daily.map((day) => {
                    const pct = summary.totalScans ? (day.count / summary.totalScans) * 100 : 0;
                    return (
                      <tr>
                        <td class="p-3 font-mono text-ink">{day.date}</td>
                        <td class="p-3 text-right font-semibold text-ink">{day.count}</td>
                        <td class="p-3 text-right">
                          <div class="flex items-center justify-end gap-2">
                            <span class="font-mono text-mute">{pct.toFixed(0)}%</span>
                            <div class="w-16 bg-canvas-soft-2 border border-hairline h-2 rounded-full overflow-hidden">
                              <div class="bg-link h-full" style={`width: ${pct}%`} />
                            </div>
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </Card>
    </div>

    <!-- Right Col: Device & Geo breakdowns (4 cols) -->
    <div class="lg:col-span-4 space-y-6">
      <!-- Device shares -->
      <Card level={2} rounded="lg" className="p-6 bg-canvas">
        <h3 class="text-sm font-semibold text-ink mb-1">Devices Shares</h3>
        <p class="text-xs text-body mb-4">Breakdown of scanner layouts.</p>

        {devices.length === 0 ? (
          <div class="text-center py-6 text-xs text-mute font-mono">No device data</div>
        ) : (
          <div class="space-y-4">
            {devices.map((dev) => {
              const pct = summary.totalScans ? (dev.count / summary.totalScans) * 100 : 0;
              return (
                <div class="space-y-1">
                  <div class="flex justify-between text-xs font-semibold text-ink capitalize">
                    <span>{dev.device}</span>
                    <span>{pct.toFixed(0)}% ({dev.count})</span>
                  </div>
                  <div class="w-full bg-canvas-soft-2 border border-hairline h-2.5 rounded-full overflow-hidden">
                    <div class="bg-primary h-full" style={`width: ${pct}%`} />
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </Card>

      <!-- Geographical Country metrics -->
      <Card level={2} rounded="lg" className="p-6 bg-canvas">
        <h3 class="text-sm font-semibold text-ink mb-1">Geography Breakdown</h3>
        <p class="text-xs text-body mb-4">Top scan locations parsed by Cloudflare.</p>

        {countries.length === 0 ? (
          <div class="text-center py-6 text-xs text-mute font-mono">No geo data</div>
        ) : (
          <div class="space-y-3 font-mono text-xs">
            {countries.map((c) => {
              const locationStr = c.city && c.city !== 'Unknown' ? `${c.city}, ${c.country}` : c.country;
              return (
                <div class="flex justify-between items-center py-1.5 border-b border-hairline last:border-0">
                  <span class="font-sans font-semibold text-ink">{locationStr}</span>
                  <span class="text-mute">{c.count} {c.count === 1 ? "scan" : "scans"}</span>
                </div>
              );
            })}
          </div>
        )}
      </Card>

      <!-- Browsers breakdown -->
      <Card level={2} rounded="lg" className="p-6 bg-canvas">
        <h3 class="text-sm font-semibold text-ink mb-1">Scanners Browsers</h3>
        <p class="text-xs text-body mb-4">Browser applications used.</p>

        {browsers.length === 0 ? (
          <div class="text-center py-6 text-xs text-mute font-mono">No browser data</div>
        ) : (
          <div class="space-y-3 font-mono text-xs">
            {browsers.map((b) => (
              <div class="flex justify-between items-center py-1.5 border-b border-hairline last:border-0">
                <span class="font-sans font-semibold text-ink">{b.browser}</span>
                <span class="text-mute">{b.count} {b.count === 1 ? "scan" : "scans"}</span>
              </div>
            ))}
          </div>
        )}
      </Card>
    </div>
  </div>
</DashboardLayout>
