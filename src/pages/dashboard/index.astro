---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import Card from "../../components/ui/Card";
import Button from "../../components/ui/Button";
import { getDB } from "../../lib/db";
import { getSessionUser } from "../../lib/auth";

const user = await getSessionUser(Astro);
if (!user) {
  return Astro.redirect("/login");
}

let qrList: any[] = [];
try {
  const db = getDB(Astro);
  
  // Fetch QR codes along with scan aggregates
  const result = await db
    .prepare(
      `SELECT q.*, COUNT(s.id) as scan_count 
       FROM qr_codes q 
       LEFT JOIN scan_analytics s ON q.id = s.qr_code_id 
       WHERE q.user_id = ? 
       GROUP BY q.id 
       ORDER BY q.created_at DESC`
    )
    .bind(user.id)
    .all<any>();
    
  if (result.results) {
    qrList = result.results;
  }
} catch (err) {
  console.error("Dashboard database fetch error:", err);
}

// Icon helper
const categoryIcons: Record<string, string> = {
  url: "🔗",
  wifi: "📶",
  vcard: "👤",
  whatsapp: "💬",
  email: "✉️",
  sms: "📱",
  phone: "📞",
  location: "📍",
  text: "📝",
};
---

<DashboardLayout title="My QR Codes" activeTab="qr">
  <!-- Header Action Button -->
  <a href="/dashboard/create" slot="header-actions">
    <Button variant="primary" size="sm" className="flex items-center gap-1.5 font-semibold text-xs h-8">
      <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      New QR Code
    </Button>
  </a>

  <!-- Dashboard Content -->
  {qrList.length === 0 ? (
    <!-- Empty State -->
    <div class="max-w-md mx-auto text-center py-16">
      <Card level={2} rounded="lg" className="p-8 bg-canvas">
        <div class="h-12 w-12 rounded-full bg-canvas-soft border border-hairline flex items-center justify-center mx-auto mb-4 text-xl">
          📂
        </div>
        <h3 class="text-base font-semibold text-ink mb-1">No QR codes yet.</h3>
        <p class="text-xs text-body mb-6">Create your first static or dynamic QR code campaign to get started.</p>
        <a href="/dashboard/create">
          <Button variant="primary" size="sm">Create QR Code</Button>
        </a>
      </Card>
    </div>
  ) : (
    <!-- QR Grid List -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {qrList.map((qr) => {
        // Parse design parameters
        let parsedConfig: any = {};
        try {
          parsedConfig = JSON.parse(qr.qr_config);
        } catch(e) {}

        const isDynamic = qr.type === "dynamic";
        const shortUrl = `realqrcodegenerator.com/r/${qr.short_code}`;

        return (
          <Card level={2} rounded="lg" className="flex flex-col justify-between hover:border-hairline-strong transition-all relative" id={`qr-card-${qr.id}`}>
            <div>
              <!-- Header Row -->
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-2">
                  <span class="text-2xl select-none" title={qr.category}>
                    {categoryIcons[qr.category] || "📦"}
                  </span>
                  <div>
                    <h3 class="text-sm font-semibold text-ink capitalize">{qr.category} QR</h3>
                    <span class="text-[10px] font-mono text-mute">
                      Created {new Date(qr.created_at).toLocaleDateString()}
                    </span>
                  </div>
                </div>

                <div class="flex gap-1.5">
                  <span class={`text-[9px] font-mono font-semibold px-2 py-0.5 rounded-full uppercase tracking-wider ${
                    isDynamic 
                      ? "bg-link-bg-soft text-link border border-link/10" 
                      : "bg-canvas-soft-2 text-body border border-hairline"
                  }`}>
                    {qr.type}
                  </span>
                </div>
              </div>

              <!-- Info Body -->
              <div class="space-y-2 mb-6">
                {isDynamic ? (
                  <div>
                    <div class="text-[10px] font-mono uppercase tracking-wider text-mute">Shortened Link</div>
                    <a href={`/r/${qr.short_code}`} target="_blank" class="text-xs font-semibold text-link hover:underline block truncate">
                      {shortUrl}
                    </a>
                    <div class="text-[10px] font-mono uppercase tracking-wider text-mute mt-2">Destination</div>
                    <div class="text-xs text-body truncate" title={qr.original_url}>
                      {qr.original_url}
                    </div>
                  </div>
                ) : (
                  <div>
                    <div class="text-[10px] font-mono uppercase tracking-wider text-mute">Static Payload</div>
                    <div class="text-xs text-body truncate font-mono bg-canvas-soft-2 px-2 py-1 rounded-sm border border-hairline max-h-12 overflow-y-auto select-all">
                      {qr.original_url || "Static Data"}
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- Footer Actions -->
            <div class="border-t border-hairline pt-4 mt-2 flex items-center justify-between gap-4">
              <!-- Scan stats summary -->
              <div>
                {isDynamic ? (
                  <div class="flex items-center gap-1.5 text-xs text-ink font-semibold">
                    <svg class="h-3.5 w-3.5 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                    <span>{qr.scan_count} {qr.scan_count === 1 ? "scan" : "scans"}</span>
                  </div>
                ) : (
                  <span class="text-[10px] font-mono text-mute uppercase">No tracking</span>
                )}
              </div>

              <div class="flex items-center gap-2">
                {isDynamic && (
                  <a href={`/dashboard/analytics?qrId=${qr.id}`}>
                    <Button variant="secondary" size="sm" className="text-xs h-7 px-2">
                      Analytics
                    </Button>
                  </a>
                )}
                
                {/* Delete Trigger */}
                <button
                  data-qr-id={qr.id}
                  class="delete-qr-btn p-1.5 rounded-sm border border-hairline hover:bg-error-soft hover:text-error hover:border-error-soft transition-colors cursor-pointer text-body"
                  title="Delete QR"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                </button>
              </div>
            </div>
          </Card>
        );
      })}
    </div>
  )}

  <script>
    // Delete QR handlers
    const deleteButtons = document.querySelectorAll(".delete-qr-btn");

    deleteButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const qrId = btn.getAttribute("data-qr-id");
        if (!qrId) return;

        if (confirm("Are you sure you want to delete this QR code? All scan analytics will be lost.")) {
          try {
            const response = await fetch("/api/qr/delete", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ qrId }),
            });

            if (response.ok) {
              // Remove card from UI
              const card = document.getElementById(`qr-card-${qrId}`);
              card?.remove();
              
              // If grid is now empty, reload page to display empty state
              if (document.querySelectorAll("[id^='qr-card-']").length === 0) {
                window.location.reload();
              }
            } else {
              alert("Failed to delete QR code. Try again.");
            }
          } catch (err) {
            alert("A network error occurred. Please try again.");
          }
        }
      });
    });
  </script>
</DashboardLayout>
