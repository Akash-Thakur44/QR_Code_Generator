---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import Card from "../../components/ui/Card";
import Button from "../../components/ui/Button";
import { getSessionUser, hashPassword } from "../../lib/auth";
import { getDB } from "../../lib/db";

const user = await getSessionUser(Astro);
if (!user) {
  return Astro.redirect("/login");
}

let errorMsg = "";
let successMsg = "";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const newPassword = data.get("password") as string;
    const confirmPassword = data.get("confirm-password") as string;
    
    if (!newPassword || !confirmPassword) {
      errorMsg = "All fields are required.";
    } else if (newPassword !== confirmPassword) {
      errorMsg = "Passwords do not match.";
    } else if (newPassword.length < 6) {
      errorMsg = "Password must be at least 6 characters long.";
    } else {
      const db = getDB(Astro);
      const hashedPassword = await hashPassword(newPassword);
      await db.prepare("UPDATE users SET password_hash = ?, updated_at = ? WHERE id = ?").bind(hashedPassword, new Date().toISOString(), user.id).run();
      successMsg = "Your password has been updated successfully.";
    }
  } catch (err: any) {
    errorMsg = err.message || "An error occurred while updating your password.";
  }
}
---

<DashboardLayout title="Account Settings" activeTab="settings">
  <div class="max-w-2xl space-y-8">
    
    <!-- Profile summary -->
    <Card level={2} rounded="lg" className="bg-canvas p-6">
      <h3 class="text-base font-semibold text-ink mb-1">Account Profile</h3>
      <p class="text-xs text-body mb-6">Your registration details and workspace credentials.</p>
      
      <div class="space-y-4">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Email Address</span>
          <span class="text-sm font-medium text-ink block mt-0.5">{user.email}</span>
        </div>
        <div>
          <span class="text-[10px] font-mono uppercase tracking-wider text-mute block">Account Created</span>
          <span class="text-sm font-medium text-ink block mt-0.5">
            {new Date(user.created_at).toLocaleDateString(undefined, { dateStyle: "long" })}
          </span>
        </div>
      </div>
    </Card>

    <!-- Subscription Plan -->
    <Card level={2} rounded="lg" className="bg-canvas p-6 border-l-4 border-l-success">
      <div class="flex items-start justify-between gap-4 mb-1">
        <h3 class="text-base font-semibold text-ink">Active Subscription</h3>
        <span class="text-[9px] font-mono font-semibold text-success bg-green-500/10 px-2 py-0.5 rounded-full uppercase tracking-wider border border-green-500/10">
          Active
        </span>
      </div>
      <p class="text-xs text-body mb-6">You are currently on the lifetime free tier. Upgrade for higher dynamic limits.</p>
      
      <div class="flex items-center justify-between border-t border-hairline pt-4 mt-4">
        <div>
          <span class="text-sm font-semibold text-ink block">Free Tier Plan</span>
          <span class="text-[10px] text-mute font-mono block">20 Dynamic QR limits • Basic Analytics</span>
        </div>
        <a href="/pricing">
          <Button variant="secondary" size="sm">Upgrade Plan</Button>
        </a>
      </div>
    </Card>

    <!-- Change Password Form -->
    <Card level={2} rounded="lg" className="bg-canvas p-6">
      <h3 class="text-base font-semibold text-ink mb-1">Update Password</h3>
      <p class="text-xs text-body mb-6">Change your security credentials. Your session will remain active.</p>

      {errorMsg && (
        <div class="flex items-start gap-2 text-error bg-error-soft/40 border border-error-soft p-3 rounded-md text-xs mb-6 w-full">
          <svg class="h-4 w-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span>{errorMsg}</span>
        </div>
      )}

      {successMsg && (
        <div class="flex items-start gap-2 text-success bg-green-500/10 border border-green-500/10 p-3 rounded-md text-xs mb-6 w-full">
          <svg class="h-4 w-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span>{successMsg}</span>
        </div>
      )}

      <form method="POST" class="space-y-4">
        <div class="flex flex-col gap-1.5 w-full">
          <label class="text-[10px] font-mono uppercase tracking-wider text-body">New Password (Min 6 chars)</label>
          <input
            type="password"
            name="password"
            required
            placeholder="••••••••"
            class="h-10 text-sm px-3 rounded-sm border border-hairline bg-canvas outline-none focus:border-hairline-strong font-sans w-full"
          />
        </div>

        <div class="flex flex-col gap-1.5 w-full">
          <label class="text-[10px] font-mono uppercase tracking-wider text-body">Confirm New Password</label>
          <input
            type="password"
            name="confirm-password"
            required
            placeholder="••••••••"
            class="h-10 text-sm px-3 rounded-sm border border-hairline bg-canvas outline-none focus:border-hairline-strong font-sans w-full"
          />
        </div>

        <Button type="submit" variant="primary" size="sm" className="font-semibold text-xs h-8">
          Save Password
        </Button>
      </form>
    </Card>

  </div>
</DashboardLayout>
