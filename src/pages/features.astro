---
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/Card";
import Button from "../components/ui/Button";
---

<Layout title="Product Features - Real QR Code Generator" description="Explore custom QR styling tools, instant dynamic redirects, edge caching, analytics, and developer APIs.">
  
  <!-- Hero Section -->
  <div class="py-16 md:py-24 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-link-bg-soft text-link text-xs font-mono font-medium mb-4">
      CAPABILITIES
    </div>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-ink mb-6">
      Engineered for speed, trust, and scans.
    </h1>
    <p class="text-lg text-body">
      Real QR Code Generator is built on top of Cloudflare's serverless edge networks, delivering sub-millisecond redirect pathways and instant real-time vector downloads.
    </p>
  </div>

  <!-- Main Feature Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto px-4">
    <!-- Feature 1: Style Designer -->
    <Card level={2} rounded="lg" className="hover:border-neutral-300 transition-colors">
      <div class="h-10 w-10 rounded-lg bg-link-bg-soft text-link flex items-center justify-center mb-6">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"></path><path d="M12 8A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 Z"></path></svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">Visual Customizer</h3>
      <p class="text-sm text-body">
        Customize colors, gradients, background opacities, body patterns, and eye frames. Drag and drop your brand logo to sit in the center of the QR canvas safely.
      </p>
    </Card>

    <!-- Feature 2: Redirections -->
    <Card level={2} rounded="lg" className="hover:border-neutral-300 transition-colors">
      <div class="h-10 w-10 rounded-lg bg-link-bg-soft text-link flex items-center justify-center mb-6">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12H3"></path><path d="M15 6L21 12L15 18"></path></svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">Dynamic Redirection</h3>
      <p class="text-sm text-body">
        Modify the target destination URL at any point. Your printed QR code remains exactly the same, but redirects are modified instantly across the edge.
      </p>
    </Card>

    <!-- Feature 3: Scan Analytics -->
    <Card level={2} rounded="lg" className="hover:border-neutral-300 transition-colors">
      <div class="h-10 w-10 rounded-lg bg-link-bg-soft text-link flex items-center justify-center mb-6">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">Real-time Analytics</h3>
      <p class="text-sm text-body">
        Monitor scan metrics by hour, day, browser agent, device layouts (mobile, desktop, tablet), and basic geographical location parameters.
      </p>
    </Card>

    <!-- Feature 4: Vector Downloads -->
    <Card level={2} rounded="lg" className="hover:border-neutral-300 transition-colors">
      <div class="h-10 w-10 rounded-lg bg-link-bg-soft text-link flex items-center justify-center mb-6">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">High-Res Vector Output</h3>
      <p class="text-sm text-body">
        Export your QR codes as lightweight scalable vector graphics (SVG) for large scale billboards and print, or high density PNGs for digital assets.
      </p>
    </Card>

    <!-- Feature 5: Security -->
    <Card level={2} rounded="lg" className="hover:border-neutral-300 transition-colors">
      <div class="h-10 w-10 rounded-lg bg-link-bg-soft text-link flex items-center justify-center mb-6">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">Campaign Security</h3>
      <p class="text-sm text-body">
        Secure your dynamic redirects with optional password access controls and expiry timelines. Archive older campaign routes cleanly without breaking analytics records.
      </p>
    </Card>

    <!-- Feature 6: SEO Target landing pages -->
    <Card level={2} rounded="lg" className="hover:border-neutral-300 transition-colors">
      <div class="h-10 w-10 rounded-lg bg-link-bg-soft text-link flex items-center justify-center mb-6">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg>
      </div>
      <h3 class="text-lg font-semibold text-ink mb-2">Dedicated QR Types</h3>
      <p class="text-sm text-body">
        Access custom landing pages designed specifically for URL links, secure WiFi configurations, vCard contacts, WhatsApp direct chat messages, SMS, and geolocation coordinates.
      </p>
    </Card>
  </div>

  <!-- Interactive Demo Showcase Section -->
  <div class="max-w-6xl mx-auto px-4 py-20">
    <div class="bg-neutral-950 text-white rounded-xl p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8 border border-neutral-800">
      <div class="max-w-xl">
        <h2 class="text-3xl font-semibold tracking-tight text-white mb-4">
          Start generating on the edge.
        </h2>
        <p class="text-neutral-400 text-sm mb-6">
          Deploy QR code tracking with zero initial investment. Generate unlimited static codes and up to 20 dynamic campaign lines on our lifetime Free Tier.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/register">
            <button class="bg-white text-neutral-950 hover:bg-neutral-100 font-semibold text-xs h-10 px-6 rounded-pill cursor-pointer active:scale-98">
              Create Free Account
            </button>
          </a>
          <a href="/">
            <button class="border border-neutral-700 hover:border-neutral-500 text-white font-semibold text-xs h-10 px-6 rounded-pill cursor-pointer active:scale-98">
              Try Generator Widget
            </button>
          </a>
        </div>
      </div>
      <!-- Decorative Mockup -->
      <div class="border border-neutral-800 bg-neutral-900 rounded-lg p-6 font-mono text-xs text-neutral-400 max-w-sm w-full shadow-lg">
        <div class="flex items-center gap-1.5 mb-4 border-b border-neutral-800 pb-2">
          <span class="h-2 w-2 rounded-full bg-red-500"></span>
          <span class="h-2 w-2 rounded-full bg-yellow-500"></span>
          <span class="h-2 w-2 rounded-full bg-green-500"></span>
          <span class="ml-2 text-[10px] text-neutral-500">cloudflare-worker.js</span>
        </div>
        <div class="space-y-1">
          <p><span class="text-violet">const</span> shortCode = <span class="text-cyan">"r8x2k"</span>;</p>
          <p><span class="text-violet">const</span> redirectUrl = <span class="text-violet">await</span> KV.get(shortCode);</p>
          <p><span class="text-neutral-500">// Sub-millisecond routing</span></p>
          <p><span class="text-violet">return</span> Response.redirect(redirectUrl, <span class="text-cyan">302</span>);</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
