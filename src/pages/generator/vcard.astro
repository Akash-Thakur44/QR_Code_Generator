---
import Layout from "../../layouts/Layout.astro";
import { QRGeneratorShell } from "../../components/qr/QRGeneratorShell";

const baseOrigin = import.meta.env.PUBLIC_QR_BASE_URL || Astro.url.origin;
---

<Layout title="Free vCard QR Code Generator - Real QR Code Generator" description="Convert business contact details (name, phone, email, company, URL) into scannable vCard QR codes. Import contacts directly to smartphones.">
  <div class="py-12 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-link-bg-soft text-link text-xs font-mono font-medium mb-4">
      VCARD GENERATOR
    </div>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-ink mb-6">
      Free vCard QR Code Generator.
    </h1>
    <p class="text-base text-body">
      Share your digital business cards instantly. Create customizable styles that add your phone number, email, company, and links directly to contacts upon scanning.
    </p>
  </div>

  <!-- Interactive Customizer preloaded with vCard -->
  <div class="py-6 mb-20">
    <QRGeneratorShell client:load defaultType="vcard" baseOrigin={baseOrigin} />
  </div>
</Layout>
