---
import Layout from "../../layouts/Layout.astro";
import { QRGeneratorShell } from "../../components/qr/QRGeneratorShell";

const baseOrigin = import.meta.env.PUBLIC_QR_BASE_URL || Astro.url.origin;
---

<Layout title="Free WiFi QR Code Generator - Real QR Code Generator" description="Share local wireless networks with guests securely. Scan to connect to home or office Wi-Fi without typing passwords. Free vector downloads.">
  <div class="py-12 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-link-bg-soft text-link text-xs font-mono font-medium mb-4">
      WIFI GENERATOR
    </div>
    <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-ink mb-6">
      Free WiFi QR Code Generator.
    </h1>
    <p class="text-base text-body">
      Share your local network credentials securely. Generate custom style codes that connect phones to your home or office Wi-Fi automatically upon scanning.
    </p>
  </div>

  <!-- Interactive Customizer preloaded with WiFi -->
  <div class="py-6 mb-20">
    <QRGeneratorShell client:load defaultType="wifi" baseOrigin={baseOrigin} />
  </div>
</Layout>
